+class FOnlineAsyncTaskSteamQueryBlockedPlayers : public FOnlineAsyncTask
+{
+public:
+	FOnlineAsyncTaskSteamQueryBlockedPlayers(FOnlineFriendsSteam* InFriendsPtr, const FUniqueNetIdSteamRef& InUserId)
+		: FriendsPtr(InFriendsPtr)
+		, UserId(InUserId)
+	{
+	}
+
+	virtual void Finalize() override
+	{
+		ISteamFriends* SteamFriendsPtr = FriendsPtr->SteamFriendsPtr;
+
+		// Couldn't find any info on this but k_EFriendFlagBlocked doesn't seem to do what is says on the tin?
+		constexpr int FriendFlags = k_EFriendFlagBlocked | k_EFriendFlagIgnored | k_EFriendFlagIgnoredFriend;
+
+		const int32 NumBlockedPlayers = SteamFriendsPtr->GetFriendCount(FriendFlags);
+
+		TArray<TSharedRef<FOnlineBlockedPlayer>>& BlockedPlayers = FriendsPtr->BlockedPlayers.FindOrAdd(UserId);
+		BlockedPlayers.Empty(NumBlockedPlayers);
+
+		for (int32 Idx = 0; Idx < NumBlockedPlayers; ++Idx)
+		{
+			const CSteamID PlayerId = SteamFriendsPtr->GetFriendByIndex(Idx, FriendFlags);
+			FString PlayerNickname = UTF8_TO_TCHAR(SteamFriendsPtr->GetFriendPersonaName(PlayerId));
+
+			BlockedPlayers.Emplace(MakeShared<FOnlineBlockedPlayerSteam>(PlayerId, MoveTemp(PlayerNickname)));
+		}
+	}
+
+	virtual void TriggerDelegates() override
+	{
+		FriendsPtr->TriggerOnQueryBlockedPlayersCompleteDelegates(*UserId, true, FString());
+	}
+
+	virtual FString ToString() const override
+	{
+		return FString::Printf(TEXT("FOnlineAsyncTaskSteamQueryBlockedPlayers UserId: %s"), *UserId->ToDebugString());
+	}
+
+	virtual bool IsDone() const override
+	{
+		return true;
+	}
+
+	virtual bool WasSuccessful() const override
+	{
+		return true;
+	}
+
+	FOnlineFriendsSteam* FriendsPtr;
+	FUniqueNetIdSteamRef UserId;
+};
