+// OSE BEGIN - New function to append a vertex after applying corner offsets.
+dtStatus dtNavMeshQuery::appendOffsetVertex(dtReal* pos, dtReal* last, dtReal* next, const dtPolyRef ref, dtReal minRad, dtQueryResult& result) const
+{
+	// Apply corner offset.
+	dtReal adjustedPos[3], tmpPoint[3];
+	applyCornerOffset(last, pos, next, adjustedPos, minRad);
+
+	// Test our new point.
+	// Clamp to polyRef if needed.
+	bool bInPoly;
+	isPointInsidePoly(ref, adjustedPos, bInPoly);
+	if (!bInPoly) {
+		if (dtStatusFailed(projectedPointOnPoly(ref, adjustedPos, tmpPoint))) {
+				const dtReal centerPos[3] = { 5,5,5 };
+				dtPolyRef nearestRef[3];
+				dtReal nearestPt[3];
+
+				if (!dtStatusFailed(findNearestContainingPoly(adjustedPos, centerPos, &clothoidFilter, nearestRef, nearestPt)))
+				{
+					dtVcopy(pos, nearestPt);
+					UE_LOG(LogTemp, Warning, TEXT("Query Succeeded!"));
+				}
+				else
+					UE_LOG(LogTemp, Warning, TEXT("Query Failed!"));
+
+			//ref
+			UE_LOG(LogTemp, Warning, TEXT("Projection Failed!"));
+		}
+		else
+			dtVcopy(pos, tmpPoint);
+	}
+	else
+		dtVcopy(pos, adjustedPos);
+
+	// Append and return results.
+	return appendVertex(pos, 0, ref, result);
+}
