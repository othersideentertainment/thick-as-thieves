+//	OSE BEGIN - Takes corner data and calculates, then applies offset for clothoid pathing
+void dtNavMeshQuery::applyCornerOffset(dtReal* last, dtReal* current, dtReal* next, dtReal* out, dtReal minRad) const
+{
+	dtReal LHV[3], RHV[3], bisector[3], outMult[3];
+	dtVsub(LHV, last, current);
+	dtVnormalize(LHV);
+	dtVsub(RHV, next, current);
+	dtVnormalize(RHV);
+	dtAngleBisect2D(LHV, RHV, bisector);
+	dtVscale(outMult, bisector, (1.1f - dtVdot2D(LHV, RHV)) * minRad);
+	dtVsub(out, current, outMult);
+}
