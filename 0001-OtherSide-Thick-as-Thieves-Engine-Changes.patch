+// (c) 2022 OtherSide Entertainment, Inc. All rights reserved.
+
+#pragma once
+
+// @TODO: Define lighting functions here, and toggle based on compile switch
+
+//--------------------------------------------------------------------------------------------------
+/// Definitions to control stylization
+//--------------------------------------------------------------------------------------------------
+
+#define OSE_STYLE_ANGLE_SOFTNESS        ( 0.05 )
+#define OSE_STYLE_ANGLE_SOFTNESS_HALF   ( OSE_STYLE_ANGLE_SOFTNESS / 2 )
+#define OSE_STYLE_WRAP_ALPHA            ( 1.0 )
+#define OSE_STYLE_TRANSMISSION_SCALAR   ( 0.1 )
+#define OSE_STYLE_SHADOW_THRESHOLD      ( 0.25 )
+
+
+//--------------------------------------------------------------------------------------------------
+/// Utility functions
+//--------------------------------------------------------------------------------------------------
+
+float OSE_RemapAngleSoftness( in float baseValue, in float someAngle )
+{
+    return smoothstep( baseValue - OSE_STYLE_ANGLE_SOFTNESS_HALF.x, baseValue + OSE_STYLE_ANGLE_SOFTNESS_HALF.x, someAngle );
+}
+
+float2 OSE_RemapAngleSoftness( in float2 baseValue, in float2 someAngle )
+{
+    return smoothstep( baseValue - OSE_STYLE_ANGLE_SOFTNESS_HALF.xx, baseValue + OSE_STYLE_ANGLE_SOFTNESS_HALF.xx, someAngle );
+}
+
+float3 OSE_RemapAngleSoftness( in float3 baseValue, in float3 someAngle )
+{
+    return smoothstep( baseValue - OSE_STYLE_ANGLE_SOFTNESS_HALF.xxx, baseValue + OSE_STYLE_ANGLE_SOFTNESS_HALF.xxx, someAngle );
+}
