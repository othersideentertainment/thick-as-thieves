+//OSE BEGIN - Custom Shading Model
+FDirectLighting OSECustomBxDF(FGBufferData GBuffer, half3 N, half3 V, half3 L, float Falloff, float NoL, FAreaLight AreaLight, FShadowTerms Shadow)
+{
+	const float wrapNoL = dot( N, L );
+	const float angleF = OSE_RemapAngleSoftness( OSE_STYLE_ANGLE_SOFTNESS, wrapNoL );
+
+	const float maskF = lerp( 0, max( 0, sign( +wrapNoL ) ), angleF );
+	const float maskR = max( 0, sign( -wrapNoL ) );
+
+	const float alphaF = max( 0, OSE_STYLE_WRAP_ALPHA );
+	const float alphaR = alphaF;
+	
+	const float wrapF = pow( max( 0, +wrapNoL + alphaF) / (1 + alphaF), (1 + alphaF) );
+	const float wrapR = pow( max( 0, +wrapNoL + alphaR) / (1 + alphaR), (1 + alphaR) );
+
+	const float energyF = 0.5 * ( 2 + alphaF ) / ( 1 + alphaF );
+	const float energyR = 0.5 * ( 2 + alphaR ) / ( 1 + alphaR );
+
+	const float finalF = ( wrapF * energyF * maskF );
+	const float finalR = ( wrapR * energyR * OSE_STYLE_TRANSMISSION_SCALAR );
+
+	NoL = ( finalF );
+
+	FDirectLighting lightingRes = DefaultLitBxDF( GBuffer, N, V, L, Falloff, NoL, AreaLight, Shadow );
+	lightingRes.Transmission = AreaLight.FalloffColor * ( Falloff * GBuffer.GBufferAO * finalR ) * Diffuse_Lambert( GBuffer.DiffuseColor );
+	return lightingRes;
+}
+//OSE END - Custom Shading Model
