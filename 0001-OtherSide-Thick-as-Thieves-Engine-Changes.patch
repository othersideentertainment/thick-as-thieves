+// OSE BEGIN -- Add support for exporting networking insights
+bool FNetworkingProfilerManager::Exec(const TCHAR* Cmd, FOutputDevice& Ar)
+{
+	if (FParse::Command(&Cmd, TEXT("NetworkingInsights.ExportPackets")))
+	{
+		Ar.Logf(TEXT("NetworkingInsights.ExportPackets %s"), Cmd);
+
+		FString ExportFilename = FParse::Token(Cmd, false);
+		ExportFilename.TrimQuotesInline();
+
+		const FString ExportPath = FPaths::GetPath(*ExportFilename);
+
+		IPlatformFile& PlatformFile = FPlatformFileManager::Get().GetPlatformFile();
+		if (!PlatformFile.DirectoryExists(*ExportPath))
+		{
+			PlatformFile.CreateDirectoryTree(*ExportPath);
+		}
+
+		const TraceServices::IAnalysisSession* Session = FInsightsManager::Get()->GetSession().Get();
+		TraceServices::FAnalysisSessionReadScope SessionReadScope(*Session);
+
+		const TraceServices::INetProfilerProvider* NetProfilerProvider = TraceServices::ReadNetProfilerProvider(*Session);
+
+		TUtf8StringBuilder<4096> StringBuilder;
+		NetProfilerProvider->ReadConnections(0, [&](const TraceServices::FNetProfilerConnection& Connection)
+		{
+			static const TTuple<TraceServices::ENetProfilerConnectionMode, FAnsiStringView> Modes[] = {
+				{ TraceServices::ENetProfilerConnectionMode::Outgoing, "Outgoing" },
+				{ TraceServices::ENetProfilerConnectionMode::Incoming, "Incoming" },
+			};
+
+			for (const auto& ModePair : Modes)
+			{
+				FStopwatch Stopwatch;
+				Stopwatch.Start();
+
+				StringBuilder.Reset();
+				StringBuilder.Append(FPathViews::GetBaseFilename(ExportFilename));
+				StringBuilder.Appendf("_Conn%02d_%.*s.csv", Connection.ConnectionId, ModePair.Value.Len(), ModePair.Value.GetData());
+
+				const FString Filename = FPaths::Combine(ExportPath, *StringBuilder);
+				IFileHandle* FileHandle = PlatformFile.OpenWrite(*Filename);
+
+				StringBuilder.Reset();
+				StringBuilder.Appendf("SequenceNumber,Timestamp,ContentSizeInBits,PacketSizeInBytes\n");
+				FileHandle->Write((const uint8*)*StringBuilder, StringBuilder.Len() * sizeof(UTF8CHAR));
+
+				const uint32 PacketCount = NetProfilerProvider->GetPacketCount(Connection.ConnectionIndex, ModePair.Key);
+
+				NetProfilerProvider->EnumeratePackets(
+					Connection.ConnectionIndex, ModePair.Key, 0, PacketCount,
+					[&](const TraceServices::FNetProfilerPacket& Packet)
+					{
+						StringBuilder.Reset();
+						StringBuilder.Appendf("%u,%0.2f,%u,%u\n", Packet.SequenceNumber, Packet.TimeStamp, Packet.ContentSizeInBits, Packet.TotalPacketSizeInBytes);
+						FileHandle->Write((const uint8*)*StringBuilder, StringBuilder.Len() * sizeof(UTF8CHAR));
+					});
+
+				FileHandle->Flush();
+				delete FileHandle;
+
+				Stopwatch.Stop();
+
+				Ar.Logf(TEXT("Exported %s in %0.3fs"), *Filename, Stopwatch.GetAccumulatedTime());
+			}
+		});
+
+		return true;
+	}
+
+	return false;
+}
