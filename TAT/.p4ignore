# Unreal Engine P4 Ignore File
# Setup locally by running "p4 set P4IGNORE=p4ignore.txt"

# Workspace Configuration File
/workspace.txt
/p4config.txt
/efconfig.txt
/Startup.bat

# CVS Files
.cvsignore
.git/
.gitattributes
.gitmodules
.hg_archival.txt
.p4ignore.txt
.p4ignore
.p4config
.tgitconfig

# Base Project Folders
obj/
.idea/
.vs/
.vscode/
.cache/
cmake-build-debug/

# Platform Files
.DS_Store
desktop.ini

# Cache Files
__pycache__/

