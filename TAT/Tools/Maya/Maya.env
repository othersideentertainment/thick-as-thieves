// ---------  TCP  Paths  ---------- //
//-- Example: TCP = D:/Perforce/TCP/
//-- Note: Use '/' for path
//--------------------------------------
TCP  = c:\depot\tcp_main\TCP\Tools\Maya\Otherside\



// ----------   TCP_MAYA     ---------- //
// --------- (Do Not Modify) ---------- //
// --(Note that Plugins and Shelves does not exist yet)-- //
TCP_SCRIPTS 	= %TCP%/TCP/Tools/Maya/Otherside/scripts
TCP_PLUGINS 	= %TCP%/TCP/Tools/Maya/Otherside/plugins
TCP_SHELVES 	= %TCP%/TCP/Tools/Maya/Otherside/shelves
TCP_ICONS 		= %TCP%/TCP/Tools/Maya/Otherside/icons


// ---------   MAYA PATHS   ----------- //
USER_SCRIPT_PATH 	= %TCP_SCRIPTS%
PYTHONPATH 			= %TCP_SCRIPTS%
MAYA_PLUG_IN_PATH 	= %TCP_PLUGINS%
MAYA_SHELF_PATH 	= %TCP_SHELVES%
XBMLANGPATH 		= %TCP_ICONS%


// --------   MAYA SETTINGS   --------- //
MAYA_NO_WARNING_FOR_MISSING_DEFAULT_RENDERER=1
MAYA_DEBUG_ENABLE_CRASH_REPORTING = 1
