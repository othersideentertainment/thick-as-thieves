// ---------  TCP_TOOLS Path  ---------- //
//-- Example: TCP_TOOLS = D:/Perforce/TCP/ArtSrc
//-- Note: Use '/' for path
//--------------------------------------
TCP_TOOLS 		= D:/Perforce/TCP/Tools



// ----------   TCP_MAYA     ---------- //
// --------- (Do Not Modify) ---------- //
TCP_SCRIPTS 	= %TCP_TOOLS%/Maya/Otherside/scripts
TCP_PLUGINS 	= %TCP_TOOLS%/Maya/Otherside/plugins
TCP_SHELVES 	= %TCP_TOOLS%/Maya/Otherside/shelves
TCP_ICONS 		= %TCP_TOOLS%/Maya/Otherside/icons


// ---------   MAYA PATHS   ----------- //
USER_SCRIPT_PATH 	= %TCP_SCRIPTS%
PYTHONPATH 			= %TCP_SCRIPTS%
MAYA_PLUG_IN_PATH 	= %TCP_PLUGINS%
MAYA_SHELF_PATH 	= %TCP_SHELVES%
XBMLANGPATH 		= %TCP_ICONS%


// --------   MAYA SETTINGS   --------- //
MAYA_NO_WARNING_FOR_MISSING_DEFAULT_RENDERER=1
MAYA_DEBUG_ENABLE_CRASH_REPORTING = 1
